  "narrative": {
    "northStar": "Le château en scène",
    "overview": "Une visite native audacieuse et luxueuse : le château occupe tout l’écran, accompagné d’un titre monumental et d’actions peu nombreuses. Les voiles pin rendent le texte ivoire lisible sans remplacer le lieu par une surface éditoriale opaque.\n\nCormorant Garamond régulier apporte l’ampleur patrimoniale ; Manrope rend les commandes directes. L’exploration conserve une légère dimension jeu vidéo, avec destinations prévisualisées, entrée immédiate et HUD contextuel. Les photographies servent exclusivement à la modélisation.",
    "keyCharacteristics": [
      "Scène 3D en direct sur tout l’écran.",
      "Grand titrage régulier et entrée circulaire.",
      "Navigation verticale superposée au lieu.",
      "Focus explicite, menus empilés et zone sûre."
    ],
    "rules": [
      {
        "name": "The Living Scene Rule",
        "body": "La couleur rend le monde lisible ; elle ne remplace pas la scène par un panneau opaque.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do conserver la scène 3D comme sujet principal.",
      "Do placer des voiles de lisibilité derrière le texte superposé.",
      "Do préserver la prévisualisation au survol et au focus, puis l’entrée en une action.",
      "Do réserver le mouvement de pression au pointeur et proposer les animations réduites."
    ],
    "donts": [
      "Don't afficher de photographie ou galerie dans l’application.",
      "Don't ajouter de contact, réservation ou argument commercial fictif.",
      "Don't revenir au panneau éditorial opaque partageant l’écran d’accueil.",
      "Don't ajouter de mouvement décoratif aux actions clavier répétées."
    ]
  }
}
